# Python caches and virtual environments
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
env/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Training artifacts and local workspace outputs
logs/
outputs/
checkpoints/
# 🔴🔴 尾斜杠 = 只匹配**目录**。这些目录一旦被软链到数据盘（AutoDL 迁移，见 docs/SFT_PIPELINE §3.10），
#     git 把 symlink 当**文件** ⟹ 上面三条**全部失效** ⟹ `git add .` 会把软链本身加进索引。
#     [实测] 2026-09-25 云端：`git status` 出现 `A  outputs`，而本地（真目录）完全看不出来。
#     ⟹ 补一组**根锚定、不带斜杠**的规则，专门覆盖 symlink 情形（对目录是冗余的，无害）。
#     ⚠️ 同类坑：任何可能被软链的路径都要这样补一份。`data/` **不要软链**
#        —— 它下面有入 git 的文件（`*.stats.json` 等），软链会让它们全部显示为已删除。
/logs
/outputs
/checkpoints
/.venv
/models
/.wheels
/results
# ⚠️ git 不支持行尾注释，写在 pattern 后面会让整条规则失效（2026-09-14 实测：/models/ 因此没生效）
# 仅忽略根目录下的模型下载目录（不能写 models/，否则会误伤 rq/models/ 与 baseline/models/）
/models/
slides/
tmp/
temp/
results/

# Common experiment files
*.log
*.out
*.err
*.ckpt
*.pt
*.pth
*.bin
*.safetensors

# W&B and Hugging Face caches
wandb/
.cache/

# ---------------------------------------------------------------------------
# M1+ 大文件（数据/编码/量化产物）—— 只提交脚本 + 小体积可复现产物
#   tracked : <short>.stats.json / <short>.item2id / <short>.*.inter
#   ignored : raw 下载物 / 图像 / .item.json(大) / 向量 .npy / 量化器
# ---------------------------------------------------------------------------
data/Amazon23/raw/
data/Amazon23/*/images/
data/Amazon23/*/*.item.json
data/**/*.npy
data/**/*.faiss
*.jsonl
!ts_rec_data/*.json

# SFT 数据集（2026-09-14 新增，~1GB，全部可由 scripts/data/prepare_sft_data.py 重建）
#   tracked : sft/stats.json ／ sft/info/{sid_vocab,prompt_templates}.json
#             （prompt_templates.json 是 config/ 的**快照**，由 prepare_sft_data.py 拷入；
#               原 data/Amazon23/sft_verify.json 与 sft_prompts_verify.json 已于 2026-09-18 删除）
#   ignored : 其余（train/valid/test CSV、index json、tasks jsonl、item_info.txt、sid2items.json、codebook.npy）
# ⚠️ 不要写 data/Amazon23/*/sft/** —— 那会把 info/ 目录本身排除掉，
#    导致下面对 info/ 内文件的 `!` 反选失效（git 不回溯被排除的目录）。
data/Amazon23/*/sft/index/*.json
data/Amazon23/*/sft/*/*.csv
data/Amazon23/*/sft/info/*.txt
data/Amazon23/*/sft/info/sid2items.json
# 用户子集清单（2026-09-25 新增，scripts/rl/make_user_subset.py 生成）
#   故意不入 git：内容完全由 (--seed, --n-users) 决定、可复现；且云端也会生成同一份文件，
#   一旦入 git 就会在 `git pull` 时撞 "untracked working tree files would be overwritten"。
data/Amazon23/*/sft/info/*.user_subset.*.json

# 渲染后的明文 prompt（2026-09-14 新增，双域双格式约 2GB，*.jsonl 已被上面全局忽略）
#   tracked : sft/prompts/stats.json ／ data/Amazon23/sft_prompts_verify.json（逐 token 校验报告）
#   ignored : sft/prompts/{alpaca,chatml}/*.jsonl

# Agent 本地工作区（记忆、临时状态）
.workbuddy/

# 第三方参考仓库（只读参考，用于对标 SID 训练配方；体积大不入 git）
refs/

# 本机环境临时物（pip 缓存/临时目录、离线 wheel 缓存）
.tmp/
.pipecache/
.wheels/

# SID 实验结果：MiniOneRec 格式的 index json 体积大（~3MB/份）且可由 .npy 重建，不入仓
# 保留 .npy / .stats.json / eval_*.json / summary.json / train_metrics.json
results/**/sid_raw.json
results/**/sid_sk.json

# ---------------------------------------------------------------------------
# 实验流水账：本地记录用，不进公开仓库
#   （结论已整理进 docs/SID_PIPELINE.md 与 docs/KNOWLEDGE_BASE.md）
docs/EXPERIMENT_LOG.md

# 早期对话中生成的旧图（非最终版），已被 docs/figures/ 取代
photo/

# 小规模探针脚本（结论已并入文档，不随仓库发布）
scripts/multimodal/_archive/


# --- baseline 目录（2026-09-13 新增）---
# results/ 这条规则会连带忽略 baseline/results/；但 baseline 的 metrics.json 只有几 KB，
# 是"数字能指回机器可读产物"的证据，必须进 git，所以显式反忽略。
!baseline/results/
!baseline/results/**
baseline/_trash_quick/
baseline/_dropped/
baseline/tmp/
